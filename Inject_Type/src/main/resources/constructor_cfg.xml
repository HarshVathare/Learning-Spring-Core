<?xml version="1.0" encoding="UTF-8" ?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">


    <bean class="org.Construction_Injection.Certi" name="certi1">
        <constructor-arg name="cource_name" value="Java Devlopment"/>
        <constructor-arg name="duration" value="6-months" />
    </bean>

    <bean class="org.Construction_Injection.Person" name="person1">
        <constructor-arg name="name" value="Rajendra Desai"/>
        <constructor-arg name="personId" value="528" type="int"/>
        <constructor-arg name="certi" ref="certi1" />
    </bean>

</beans>