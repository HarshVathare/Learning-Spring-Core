<?xml version="1.0" encoding="UTF-8" ?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:util="http://www.springframework.org/schema/util"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/context
                           http://www.springframework.org/schema/context/spring-context.xsd
                           http://www.springframework.org/schema/util
                           http://www.springframework.org/schema/util/spring-util.xsd
       ">


    <context:component-scan base-package="org.StereoType_Annotation" />


<!--    Standalone Collection  -->
    <util:list list-class="java.util.Vector" id="myfreids">
        <value>harsh</value>
        <value>Raju</value>
        <value>Soham</value>
        <value>Ritik</value>
    </util:list>

    <util:map map-class="java.util.HashMap" id="mapwisedata">
        <entry key="java" value="6-months"/>
        <entry key=".Net" value="2-months"/>
        <entry key="python" value="4-months"/>
        <entry key="javascript" value="3-months"/>
    </util:map>



    <bean class="org.standAlone_collection.Person" name="person1">
        <property name="friends" ref="myfreids"/>
        <property name="course" ref="mapwisedata" />
    </bean>

</beans>